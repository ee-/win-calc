+  color: var(--text);
+  font: inherit;
+  font-size: 12px;
+  cursor: default;
+}
+
+.history-clear:hover { background: var(--history-item); }
+
+.drawer {
+  position: absolute;
+  inset: 0;
+  z-index: 2;
+  background: var(--drawer);
