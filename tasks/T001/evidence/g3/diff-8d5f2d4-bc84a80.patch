+.mode-item:hover { background: var(--drawer-hover); }
+.mode-item[aria-current="true"] { font-weight: 600; }
+.mode-item[aria-current="true"]::before { content: "\2713"; margin-right: 8px; }
+
+.mode-label { flex: 1; }
+.mode-shortcut { font-size: 11px; color: var(--text-muted); }
