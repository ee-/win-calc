+/*
+ * Windows 11 Calculator look: dark by default, per-mode keypad geometry
+ * (four columns, 2px gaps), and the app's colour roles - digits, operators,
+ * the accent equals key, and the smaller function keys.
+ *
+ * ponytail: 340px window, no responsive breakpoints; the real app is fixed
+ * size too. Widen the width variables if the owner wants a larger window.
+ */
+:root {
+  --window: #202020;
+  --surface: #202020;
+  --text: #ffffff;
+  --text-muted: #a0a0a0;
+  --stroke: rgba(255, 255, 255, 0.08);
+  --key-digit: #3b3b3b;
+  --key-function: #323232;
+  --key-operator: #323232;
+  --key-digit-hover: #404040;
+  --key-function-hover: #3b3b3b;
+  --key-operator-hover: #3b3b3b;
+  --key-hover: rgba(255, 255, 255, 0.08);
+  --key-active: rgba(0, 0, 0, 0.18);
+  --key-disabled: rgba(255, 255, 255, 0.35);
+  --accent: #60cdff;
+  --accent-hover: #52bff2;
+  --accent-active: #47afe0;
+  --on-accent: #000000;
+  --drawer: #2b2b2b;
+  --drawer-hover: rgba(255, 255, 255, 0.08);
+  --history-item: rgba(255, 255, 255, 0.04);
+  --width: 340px;
+  --history-width: 232px;
+  --key-height: 48px;
+  --radius-window: 8px;
+  --radius-key: 4px;
+}
+
+html[data-theme="light"] {
+  --window: #f3f3f3;
+  --surface: #f3f3f3;
+  --text: #000000;
+  --text-muted: #616161;
+  --stroke: rgba(0, 0, 0, 0.08);
+  --key-digit: #fdfdfd;
+  --key-function: #f0f0f0;
+  --key-operator: #f0f0f0;
+  --key-digit-hover: #f6f6f6;
+  --key-function-hover: #e8e8e8;
+  --key-operator-hover: #e8e8e8;
+  --key-hover: rgba(0, 0, 0, 0.08);
+  --key-active: rgba(0, 0, 0, 0.1);
+  --key-disabled: rgba(0, 0, 0, 0.35);
+  --accent: #0067c0;
+  --accent-hover: #1975c5;
+  --accent-active: #3183ca;
+  --on-accent: #ffffff;
+  --drawer: #f9f9f9;
+  --drawer-hover: rgba(0, 0, 0, 0.06);
+  --history-item: rgba(0, 0, 0, 0.04);
+}
+
+* { box-sizing: border-box; }
+
+/* Class selectors below set display, which would otherwise outrank the UA
+ * [hidden] rule. */
+[hidden] { display: none !important; }
+
+body {
+  margin: 0;
+  min-height: 100vh;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  background: #1c1c1c;
+  font-family: "Segoe UI Variable Text", "Segoe UI", system-ui, -apple-system, sans-serif;
+  color: var(--text);
+}
+
+html[data-theme="light"] body { background: #e5e5e5; }
+
+.calc {
+  position: relative;
+  width: var(--width);
+  overflow: hidden;
+  border-radius: var(--radius-window);
+  background: var(--window);
+  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45);
+  user-select: none;
+}
+
+.calc.history-open { width: calc(var(--width) + var(--history-width)); }
+
+.titlebar {
