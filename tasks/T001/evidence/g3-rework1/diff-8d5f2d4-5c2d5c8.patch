+  align-items: center;
+  gap: 8px;
+  height: 40px;
+  padding: 0 8px;
+}
+
+.title {
+  flex: 1;
+  font-size: 12px;
+  font-weight: 600;
+  letter-spacing: 0.01em;
+}
+
+.titlebar-button {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  width: 32px;
+  height: 32px;
+  padding: 0;
+  border: 0;
+  border-radius: var(--radius-key);
+  background: transparent;
+  color: var(--text);
+  font: inherit;
+  cursor: default;
+}
+
+.titlebar-button:hover { background: var(--key-hover); }
+.titlebar-button:active { background: var(--key-active); }
+.titlebar-button[aria-pressed="true"] { background: var(--key-hover); }
+
+.body { display: flex; }
+
+.surface {
+  flex: 1 1 auto;
+  min-width: 0;
+  padding: 0 4px 4px;
+}
+
+.display {
+  padding: 0 6px 6px;
+  text-align: right;
+}
+
+.expression {
+  min-height: 18px;
+  font-size: 12px;
+  color: var(--text-muted);
+  overflow: hidden;
+  white-space: nowrap;
+  direction: rtl;
+}
+
+.value {
