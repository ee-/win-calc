++  assert.equal(format.formatNumber(-0), "-0");
++  assert.equal(format.formatNumber(0), "0");
++  assert.equal(format.formatNumber(-0.0), "-0");
++  assert.equal(format.formatNumber(-1), "-1");
++});
++
